# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server configuration
PORT=3000
NODE_ENV="development"

# Auth and session security secret (min 32 random characters in production)
AUTH_SECRET="gentlearrow307_secure_session_signing_secret_key"

# AI Provider and model selection defaults
AI_DEFAULT_MODEL="gemini-3.8-flash"
AI_AVAILABLE_MODELS="gemini-3.8-flash,gemini-3.1-flash-lite"

# Optional: Local model gateway endpoint (for self-hosted LocalAI / Qwen3 runtimes)
# LOCAL_MODEL_GATEWAY_URL="http://127.0.0.1:18800/v1"
# GATEWAY_INTERNAL_API_KEY="optional_gateway_bearer_key"

# Storage configuration (defaults to local workspace storage '.data/' when S3 is omitted)
STORAGE_PROVIDER="local"
# STORAGE_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# STORAGE_BUCKET="gentlearrow307-private"
# STORAGE_ACCESS_KEY="optional_s3_access_key"
# STORAGE_SECRET_KEY="optional_s3_secret_key"

